----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
}
----

///|
async fn native_environment() -> Map[String, String] {
  let environment : Map[String, String] = Map([])
  if @env.get_env_var("OS") != Some("Windows_NT") {
    return environment
  }
  let program_files = @env.get_env_var("ProgramFiles(x86)").unwrap_or(
    "C:\\Program Files (x86)",
  )
  let discovery = @shell.Cmd(
    program_files + "\\Microsoft Visual Studio\\Installer\\vswhere.exe",
    [
      "-latest", "-products", "*", "-requires", "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
      "-property", "installationPath",
    ],
  ).output()
  if discovery.exit_code() != 0 {
    fail("MSVC discovery failed: " + discovery.stderr())
  }
  let root = discovery.stdout().trim().to_owned()
  if root.is_empty() {
    fail("Install MSVC C++ Build Tools before native verification")
  }
  // cmd is required only to initialize Microsoft's developer environment.
  // Its captured environment is kept in memory and never printed.
  // The temporary file only bridges cmd's batch-file quoting rules. Discovery,
  // parsing, validation and all process orchestration remain in this script.
  @fs.mkdir("_build", allow_exist=true)
  @fs.write_file(
    "_build/msvc-environment.cmd",
    "@chcp 65001 >nul\r\n@call \"\{root}\\Common7\\Tools\\VsDevCmd.bat\" -arch=x64 -host_arch=x64 >nul\r\n@echo __MOON_MSVC_EXIT__=%errorlevel%\r\n@set\r\n",
  )
  let setup = @shell.Cmd("cmd.exe", ["/d", "/c", "_build\\msvc-environment.cmd"]).output()
  if setup.exit_code() != 0 {
    fail("MSVC environment setup failed: " + setup.stderr())
  }
  for line in setup.stdout().split("\n") {
    match line.trim().split_once("=") {
      Some((name, value)) if !name.is_empty() =>
        environment[name.to_owned()] = value.to_owned()
      _ => ()
    }
  }
  if environment.get("__MOON_MSVC_EXIT__") != Some("0") {
    fail("Microsoft's developer environment did not initialize successfully")
  }
  environment.remove("__MOON_MSVC_EXIT__")
  let tools : Map[String, String] = Map([])
  for executable in ["cl.exe", "lib.exe", "moon.exe"] {
    let found = @shell.Cmd("where.exe", [executable], env=environment).output()
    found.check()
    tools[executable] = found.stdout().split("\n").to_array()[0]
      .trim()
      .to_owned()
  }
  let project = @env.current_dir().unwrap()
  // Bump this revision when the adapter contract changes to invalidate native caches.
  let cache = "_build/msvc-compat/v1"
  let bridge = project + "/" + cache + "/cl.exe"
  let archiver = project + "/" + cache + "/lib.exe"
  @fs.mkdir(cache, recursive=true, allow_exist=true)
  let launcher = @fs.read_file("scripts/msvc-launcher.c").text()
  let stamp = cache + "/launcher-source.txt"
  if !@fs.exists(bridge) ||
    !@fs.exists(archiver) ||
    !@fs.exists(stamp) ||
    @fs.read_file(stamp).text() != launcher {
    @shell.Cmd(
      tools["cl.exe"],
      [
        "/nologo",
        "/W4",
        "/WX",
        "/O2",
        "scripts/msvc-launcher.c",
        "/Fo" + cache + "/launcher.obj",
        "/Fe" + bridge,
      ],
      env=environment,
    ).run()
    @shell.Cmd(
      tools["cl.exe"],
      [
        "/nologo",
        "/W4",
        "/WX",
        "/O2",
        "/DMOON_IPP_ARCHIVER",
        "scripts/msvc-launcher.c",
        "/Fo" + cache + "/archiver.obj",
        "/Fe" + archiver,
      ],
      env=environment,
    ).run()
    @fs.write_file(stamp, launcher)
  }
  environment["MOON_IPP_REAL_CL"] = tools["cl.exe"]
  environment["MOON_IPP_REAL_LIB"] = tools["lib.exe"]
  environment["MOON_IPP_MOON"] = tools["moon.exe"]
  environment["MOON_IPP_CL_SCRIPT"] = project + "/scripts/msvc-cl.mbtx"
  let moon_home = @env.get_env_var("MOON_HOME").unwrap_or(
    @env.get_env_var("USERPROFILE").unwrap() + "/.moon",
  )
  environment["MOON_IPP_INCLUDE"] = moon_home + "/include"
  environment["MOON_AR"] = archiver
  environment["VSLANG"] = "1033"
  environment["CL"] = environment.get("CL").unwrap_or("") + " /we4005"
  environment["CC"] = bridge
  environment["MOON_CC"] = bridge
  environment
}

///|
async fn main {
  let environment = native_environment()
  let arguments = @env.args()
  if arguments.length() > 1 && arguments[1] == "--run" {
    let command = ["run", "cmd/main", "--target", "native", "--"]
    for argument in arguments[2:] {
      command.push(argument)
    }
    @shell.Cmd("moon", command, env=environment).run()
    return
  }
  let native_only = arguments.contains("--native-only")
  let commands = if native_only {
    [
      ["check", "--deny-warn"],
      ["test", "--deny-warn"],
      ["build", "--deny-warn"],
    ]
  } else {
    [
      ["check", "--target", "wasm-gc", "--deny-warn"],
      ["test", "--target", "wasm-gc", "--deny-warn"],
      ["check", "--target", "js", "--deny-warn"],
      ["test", "--target", "js", "--deny-warn"],
      ["check", "--deny-warn"],
      ["test", "--deny-warn"],
      ["build", "--deny-warn"],
      ["fmt", "--check"],
      [
        "fmt", "scripts/verify.mbtx", "scripts/msvc-cl.mbtx", "scripts/interop_boundaries.mbtx",
        "--check",
      ],
    ]
  }
  for command in commands {
    if command == ["test", "--deny-warn"] &&
      environment.contains("MOON_IPP_REAL_CL") {
      @shell.Cmd(
        "moon",
        ["run", "--deny-warn", "scripts/msvc-cl.mbtx", "--self-test"],
        env=environment,
      ).run()
    }
    println("moon " + command.join(" "))
    @shell.Cmd("moon", command, env=environment).run()
  }
  println("Verification passed")
}
