import {
  "liyun6666/moon-ipp" @ipp,
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/js_async",
  "moonbitlang/core/buffer",
  "moonbitlang/core/debug",
}

supported_targets = "+native+js"

// HTTP and JS stream imports are used by different backend-selected files.
// All correctness, FFI and runtime diagnostics remain enabled.

warnings = "-unused_package"

options(
  targets: { "transport_js.mbt": [ "js" ], "transport_js_wbtest.mbt": [ "js" ] },
)
